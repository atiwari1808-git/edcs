/* Handover Scheduler — tokens copied exactly from the PAMS Django templates */
:root {
  --indigo:#4f46e5; --indigo-dark:#3730a3; --brand-blue:#012970;
  --blue:#3b82f6;   --blue-dark:#2563eb;   --blue-bg:#dbeafe;   --blue-text:#1d4ed8;
  --green:#10b981;  --green-dark:#059669;  --green-bg:#dcfce7;  --green-text:#059669;
  --amber:#f59e0b;  --amber-dark:#d97706;  --amber-bg:#fef3c7;  --amber-text:#b45309;
  --purple:#8b5cf6; --purple-dark:#7c3aed; --purple-bg:#ede9fe; --purple-text:#7c3aed;
  --red:#ef4444;    --red-dark:#dc2626;    --red-bg:#fee2e2;    --red-text:#dc2626;

  --page-bg:#f1f5f9; --surface:#fff; --surface-alt:#f8faff;
  --border:#e8edf5; --border-strong:#e0e7ff; --border-row:#f1f5f9;
  --text:#1e1b4b; --text-secondary:#64748b; --text-tertiary:#94a3b8;

  --radius-card:18px; --radius-box:14px; --radius-md:10px; --radius-full:999px;
  --shadow-card:0 3px 16px rgba(0,0,0,.055);
  --shadow-card-hover:0 10px 32px rgba(79,70,229,.13);
  --shadow-box:0 2px 8px rgba(0,0,0,.04);
  --font-body:'Segoe UI',system-ui,-apple-system,BlinkMacSystemFont,sans-serif;

  /* aliases for a few older inline style="" references across templates */
  --danger:var(--red-text); --success:var(--green-text); --primary-active:var(--indigo-dark);
  --surface-alt-2:var(--surface-alt); --info-bg:#eff6ff; --warning:var(--amber-dark);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:var(--font-body);color:var(--text);min-height:100vh}
body{background:var(--page-bg)}
body.auth-body{display:flex;align-items:center;justify-content:center;background:linear-gradient(132deg,#ebefefed 0%,#6b8deab3 100%)}
h1{font-size:1.45rem;font-weight:800;margin:0 0 4px;letter-spacing:-.03em;color:var(--text)}
h2{font-size:.97rem;font-weight:700;margin:0 0 10px;color:var(--text)}
p{color:var(--text-tertiary);margin:0 0 16px;line-height:1.55;font-size:.84rem}
a{color:var(--indigo)}
i.bi{line-height:1}

/* ── Navbar ── */
.navbar{height:60px;background:var(--surface);border-bottom:none;display:flex;align-items:center;justify-content:space-between;padding:0 2rem;position:sticky;top:0;z-index:50;box-shadow:0 2px 20px rgba(1,41,112,.1)}
.navbar .brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:1.3rem;color:var(--brand-blue);text-decoration:none;white-space:nowrap}
.logo-mark{width:26px;height:26px}
.nav-right{display:flex;align-items:center;gap:.5rem}
.pill{display:inline-flex;align-items:center;gap:.4rem;padding:.42rem .95rem;border-radius:var(--radius-full);font-size:.8rem;font-weight:700;text-decoration:none;border:1.5px solid transparent}
.pill.user{background:linear-gradient(135deg,#657ce5,#120aa5);color:#fff;box-shadow:0 2px 8px rgba(79,70,229,.28);border-radius:var(--radius-full)}
.pill.logout{background:#fff1f2;color:#e11d48;border-color:#fecdd3}
.pill.logout:hover{background:#ffe4e6}
.pill.navlink{background:#eef2ff;color:var(--brand-blue);border-color:#c7d2fe;border-radius:8px}
.pill.navlink:hover{background:#e0e7ff;color:var(--indigo-dark)}
.pill.navlink.active{background:linear-gradient(135deg,#657ce5,#120aa5);color:#fff;border-color:transparent}
.nav-sep{width:1px;height:26px;background:#e2e8f0;margin:0 4px}

/* ── Shell: sidebar + content ── */
.app-shell{display:flex;min-height:calc(100vh - 60px)}
.sidebar{width:224px;background:var(--surface);border-right:1px solid var(--border);padding:18px 12px;flex-shrink:0}
.sidebar a{display:flex;align-items:center;gap:10px;padding:.6rem .85rem;margin:2px 0;border-radius:8px;color:var(--text-secondary);text-decoration:none;font-size:.85rem;font-weight:600}
.sidebar a i.bi{font-size:1rem;width:18px;text-align:center}
.sidebar a:hover{background:#eef2ff;color:var(--indigo-dark)}
.sidebar a.active{background:linear-gradient(135deg,#657ce5,#120aa5);color:#fff}
.content-area{flex:1;min-width:0}
.container{max-width:1280px;margin:0 auto;padding:1.6rem 2.5rem 3rem}

/* ── Panels / cards ── */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-card);box-shadow:var(--shadow-card);transition:box-shadow .2s,transform .2s}
.panel.pad{padding:1.35rem}
.empty-state{text-align:center;padding:3.5rem 1rem;color:#cbd5e1}
.empty-state .bi{font-size:2.4rem;display:block;margin-bottom:.6rem;opacity:.4}

/* ── Forms ── */
.field-group{margin-bottom:15px}
.field-group label{display:block;font-size:.8rem;font-weight:700;margin-bottom:5px;color:var(--text)}
.field-hint{font-size:.74rem;color:var(--text-tertiary);margin-top:4px}
input[type=text],input[type=email],input[type=password],input[type=date],select,textarea{
  width:100%;padding:.6rem .8rem;border:1.5px solid var(--border-strong);border-radius:var(--radius-md);
  font:inherit;font-size:.87rem;background:var(--surface);color:var(--text)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--indigo);box-shadow:0 0 0 3px rgba(79,70,229,.12)}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.58rem 1.1rem;border:none;
  border-radius:var(--radius-md);font:700 .83rem var(--font-body);cursor:pointer;text-decoration:none;transition:opacity .15s,transform .12s}
.btn-primary{background:linear-gradient(135deg,#657ce5,#120aa5);color:#fff}
.btn-primary:hover{opacity:.92}
.btn-primary:disabled{background:#cbd5e1;cursor:not-allowed;opacity:1}
.btn-secondary{background:#fff;border:1.5px solid var(--border-strong);color:var(--text)}
.btn-secondary:hover{background:var(--surface-alt)}
.btn-success{background:linear-gradient(135deg,#10b981,#059669);color:#fff}
.btn-success:hover{opacity:.9}
.btn-ghost{background:transparent;color:var(--text-secondary)}
.btn-ghost:hover{background:var(--surface-alt)}
.btn-danger{background:var(--red-bg);color:var(--red-text)}
.btn-danger:hover{background:#fecaca}
.btn-block{width:100%}
.btn-sm{padding:.42rem .85rem;font-size:.78rem}

/* ── Alerts (left-border style, matching PAMS) ── */
.flash-stack{position:fixed;top:70px;right:22px;z-index:100;display:flex;flex-direction:column;gap:8px;max-width:400px}
.alert{padding:.7rem 1rem;border-radius:10px;font-size:.86rem;font-weight:600;border:none;box-shadow:0 4px 14px rgba(0,0,0,.08);animation:slide .25s}
@keyframes slide{from{transform:translateX(30px);opacity:0}}
.alert-success{background:#f0fdf4;color:#166534;border-left:4px solid #22c55e}
.alert-danger,.alert-error{background:#fff1f2;color:#9f1239;border-left:4px solid #f43f5e}
.alert-warning{background:#fffbeb;color:#92400e;border-left:4px solid #f59e0b}
.alert-info{background:#eff6ff;color:#1e40af;border-left:4px solid #3b82f6}

/* ── Badges / status pills (bp- = job status; bdg- = small inline tag) ── */
.badge{display:inline-flex;align-items:center;gap:.3rem;padding:.28rem .75rem;border-radius:var(--radius-full);font-size:.75rem;font-weight:700;text-transform:capitalize}
.badge-pass,.badge-PASSED,.badge-scheduled,.badge-REQUESTED,.badge-CONFIRMED{background:#dcfce7;color:#166534}
.badge-fail,.badge-FAILED,.badge-cancelled,.badge-CANCELLED{background:#fee2e2;color:#991b1b}
.badge-ERROR{background:#fef9c3;color:#854d0e}
.badge-RUNNING,.badge-PENDING,.badge-upcoming{background:#dbeafe;color:#1e40af}
.badge-completed{background:#eef2ff;color:#4f46e5}
.pill-person{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .65rem;border-radius:var(--radius-full);background:#eef2ff;color:#4f46e5;font-size:.75rem;font-weight:700}

/* ── Tables (jtable style) ── */
.data-table{width:100%;border-collapse:collapse;font-size:.83rem}
.data-table thead tr{background:var(--surface-alt)}
.data-table th{text-align:left;padding:.65rem 1.1rem;color:var(--text-tertiary);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;border-bottom:1px solid var(--border)}
.data-table td{padding:.7rem 1.1rem;border-bottom:1px solid var(--border-row)}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:#fafbff}

/* ── Stat cards (exact PAMS stat-box) ── */
.dashboard-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.6rem;gap:1rem;flex-wrap:wrap}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem;margin-bottom:1.6rem}
.stat-card{background:#fff;border-radius:var(--radius-box);padding:1rem 1.2rem;border:1px solid var(--border);box-shadow:var(--shadow-box);display:flex;align-items:center;gap:.85rem}
.stat-icon-badge{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.stat-icon-badge.acc-indigo{background:#eef2ff;color:#4f46e5}
.stat-icon-badge.acc-blue{background:#dbeafe;color:#2563eb}
.stat-icon-badge.acc-green{background:#dcfce7;color:#059669}
.stat-icon-badge.acc-red{background:#fee2e2;color:#dc2626}
.stat-icon-badge.acc-orange{background:var(--amber-bg);color:var(--amber-text)}
.stat-icon-badge.acc-purple{background:var(--purple-bg);color:var(--purple-text)}
.stat-card h3{margin:0;font-size:1.5rem;font-weight:800;color:var(--text);line-height:1}
.stat-card span{font-size:.72rem;color:var(--text-tertiary);font-weight:500}
.filter-bar{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap}
.table-toolbar{display:flex;justify-content:space-between;align-items:center;margin:1.1rem 0 .7rem;padding:1.1rem 1.4rem 0}

/* ── Accent top-stripe cards (task-card style, used for check/progress cards) ── */
.accent-card,.check-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-card);
  padding:0;text-align:center;box-shadow:var(--shadow-card);position:relative;overflow:hidden;transition:box-shadow .2s,transform .2s}
.accent-card:hover,.check-card:hover{box-shadow:var(--shadow-card-hover);transform:translateY(-3px)}
.accent-card::before,.check-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px}
.check-card.pass::before{background:linear-gradient(90deg,#10b981,#059669)}
.check-card.fail::before{background:linear-gradient(90deg,#ef4444,#dc2626)}
.check-card.running::before{background:linear-gradient(90deg,#3b82f6,#2563eb)}
.check-card .check-icon{font-size:1.5rem;margin:18px 0 6px}
.check-card h4{margin:0 0 12px;font-size:.88rem;font-weight:700;padding:0 16px}
.check-card .badge{margin-bottom:16px}
.progress-track{height:6px;background:var(--surface-alt);border-radius:5px;overflow:hidden;margin:0 16px 16px}
.progress-track>span{display:block;height:100%;background:var(--indigo);transition:width .5s}
.section-block{margin-top:2rem}

/* ── Verify ── */
.verify-layout{display:grid;grid-template-columns:minmax(320px,400px) 1fr;gap:1.3rem;align-items:stretch}
.verify-layout>.panel{height:100%;display:flex;flex-direction:column}
.verify-layout>.panel>.empty-state{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.verify-layout>.panel>.empty-state .bi{font-size:2.2rem;opacity:.35;color:var(--indigo)}
.overall-banner{padding:.8rem 1.1rem;border-radius:10px;font-weight:700;font-size:.9rem;margin-bottom:1rem;border:none}
.overall-banner.pass{background:#f0fdf4;color:#166534;border-left:4px solid #22c55e}
.overall-banner.fail{background:#fff1f2;color:#9f1239;border-left:4px solid #f43f5e}
.overall-banner.error{background:#fffbeb;color:#92400e;border-left:4px solid #f59e0b}
.check-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;margin-bottom:1rem}

/* ── Scheduler / calendar (compact, PAMS-themed) ── */
.tool-chip{display:inline-flex;align-items:center;gap:.45rem;background:#fff;color:var(--indigo);border:2px solid #c7d2fe;
  border-radius:var(--radius-full);padding:.42rem 1rem;font-weight:700;font-size:.8rem;margin-bottom:8px;box-shadow:0 2px 8px rgba(79,70,229,.1)}
.slot-note{font-size:.8rem;color:var(--text-tertiary);margin-bottom:14px}
.scheduler-layout{display:grid;grid-template-columns:minmax(560px,2.3fr) minmax(360px,1fr);gap:1.5rem;align-items:start}
.holidays-card{width:100%}
.picker-grid{display:grid;grid-template-columns:minmax(360px,440px) minmax(300px,400px);gap:1.8rem;align-items:start}
.picker-col-cal,.picker-col-form{min-width:0}
.calendar-legend{display:flex;gap:14px;font-size:.76rem;color:var(--text-secondary);margin-bottom:12px;font-weight:600}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px;vertical-align:1px}
.dot-bookable{background:var(--green)}
.dot-booked{background:var(--red)}
.dot-blocked{background:var(--border-strong)}
.calendar-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}
.calendar-header h3{margin:0;font-size:1rem;font-weight:800;color:var(--text)}
.cal-nav-btn{width:30px;height:30px;border:1.5px solid var(--border-strong);background:#fff;border-radius:8px;cursor:pointer;font-size:.9rem;color:var(--indigo)}
.cal-nav-btn:hover{background:#eef2ff}
.cal-weekdays{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;font-size:.72rem;color:var(--text-tertiary);font-weight:800;margin-bottom:6px}
#calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:9px;font-size:.86rem;font-weight:700;border:1px solid transparent;max-width:46px;max-height:46px;width:100%;margin:0 auto}
.cal-day.bookable{background:#dcfce7;color:#059669;cursor:pointer}
.cal-day.bookable:hover{outline:2px solid #10b981}
.cal-day.selected{outline:2.5px solid var(--indigo);background:#eef2ff;color:var(--indigo)}
.cal-day.booked{background:#fee2e2;color:#dc2626;cursor:not-allowed}
.cal-day.blocked{background:var(--surface-alt);color:var(--text-tertiary);cursor:not-allowed}
.cal-day.empty{visibility:hidden}
.slot-pick{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 4px}
.slot-btn{border:1.5px solid var(--border-strong);background:#fff;border-radius:9px;padding:.4rem .75rem;font:700 .78rem var(--font-body);cursor:pointer;color:var(--text)}
.slot-btn.sel{border-color:var(--indigo);background:#eef2ff;color:var(--indigo)}
.booking-preview{background:var(--surface-alt);border:1.5px dashed #c7d2fe;border-radius:11px;padding:.65rem .9rem;font-size:.8rem;margin:12px 0;display:grid;gap:4px}

/* ── Auth card (exact PAMS login: sharp radius, dramatic shadow) ── */
.auth-card{width:420px;max-width:94vw;background:#fff;border-radius:5px;box-shadow:0 25px 60px rgba(0,0,0,.4);padding:2.5rem 2rem;text-align:center}
.auth-card .brand-row{display:flex;align-items:center;justify-content:center;gap:8px;font-weight:700;font-size:1.5rem;color:#1a1d29;margin-bottom:4px}
.auth-sub{font-size:.9rem;color:#64748b;margin-bottom:1.8rem}
.auth-alt{font-size:.85rem;text-align:center;margin-top:16px;color:#64748b}
.auth-card .field-group{text-align:left}
.auth-card input{border-radius:10px;padding:.75rem 1rem;border:1.5px solid #e2e8f0}
.auth-card input:focus{border-color:#0d6efd;box-shadow:0 0 0 3px rgba(13,110,253,.12)}
.auth-card .btn-primary{background:linear-gradient(135deg,#0d6efd,#6610f2);border-radius:10px;padding:.75rem;font-size:1rem;letter-spacing:.02em}

@media (max-width:1000px){
  .verify-layout{grid-template-columns:1fr}
  .scheduler-layout{grid-template-columns:1fr}
  .holidays-card{width:100%}
  .picker-grid{grid-template-columns:1fr}
}