<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>EDCS Report {{ r.job.jira_id }}</title>
<style>
body{font-family:Arial,Helvetica,sans-serif;margin:24px;color:#222}
h1{font-size:20px} h2{font-size:16px;border-bottom:1px solid #ccc;padding-bottom:4px}
table{border-collapse:collapse;width:100%;margin:8px 0}
th,td{border:1px solid #ddd;padding:6px 8px;font-size:13px;text-align:left}
th{background:#f4f4f4}
.PASS{color:#0a7d24;font-weight:bold}.FAIL{color:#c0202a;font-weight:bold}.ERROR{color:#b36b00;font-weight:bold}
.sev-CRITICAL{background:#ffd6d6}.sev-HIGH{background:#ffe8cc}.sev-MEDIUM{background:#fff7cc}
.sev-LOW{background:#eef6ff}.sev-INFO{background:#f2f2f2}
.badge{display:inline-block;padding:2px 10px;border-radius:4px;color:#fff}
.badge.PASS{background:#0a7d24}.badge.FAIL{background:#c0202a}.badge.ERROR{background:#b36b00}
</style></head><body>
<h1>EDCS Compliance Report &mdash; {{ r.job.jira_id }}
  <span class="badge {{ r.overall_status.value }}">{{ r.overall_status.value }}</span></h1>
<p>Repository: {{ r.job.repo_url }}<br>
Scanned: {{ r.started_at }} &rarr; {{ r.finished_at }} | Job: {{ r.job.job_id }}</p>

<h2>Document Scan &mdash; <span class="{{ r.doc_status.value }}">{{ r.doc_status.value }}</span>
 (Compliance {{ r.compliance_score }}%)</h2>
<table><tr><th>Name</th><th>Version</th><th>Owner</th><th>Size</th><th>Modified</th></tr>
{% for d in r.documents %}<tr><td>{{ d.name }}</td><td>{{ d.version }}</td><td>{{ d.owner }}</td>
<td>{{ d.size_bytes }}</td><td>{{ d.modified }}</td></tr>{% endfor %}</table>

<h3>Document Findings ({{ r.doc_findings|length }})</h3>
<table><tr><th>Severity</th><th>Category</th><th>File/Doc</th><th>Reason</th><th>Recommendation</th></tr>
{% for f in r.doc_findings %}<tr class="sev-{{ f.severity.value }}"><td>{{ f.severity.value }}</td>
<td>{{ f.category }}</td><td>{{ f.file }}</td><td>{{ f.reason }}</td><td>{{ f.recommendation }}</td></tr>{% endfor %}</table>

<h2>Code Scan &mdash; <span class="{{ r.code_status.value }}">{{ r.code_status.value }}</span></h2>
<table><tr><th>Severity</th><th>Category</th><th>File</th><th>Line</th><th>Match (masked)</th><th>Reason</th><th>Recommendation</th></tr>
{% for f in r.code_findings %}<tr class="sev-{{ f.severity.value }}"><td>{{ f.severity.value }}</td>
<td>{{ f.category }}</td><td>{{ f.file }}</td><td>{{ f.line }}</td><td><code>{{ f.matched_text }}</code></td>
<td>{{ f.reason }}</td><td>{{ f.recommendation }}</td></tr>{% endfor %}</table>

<h2>Statistics</h2>
<table>{% for k, v in r.stats.items() %}<tr><th>{{ k }}</th><td>{{ v }}</td></tr>{% endfor %}</table>
</body></html>
