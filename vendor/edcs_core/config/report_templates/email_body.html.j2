<html><body style="font-family:Arial,sans-serif;font-size:14px;color:#222">
<h2>EDCS Scan Result: {{ r.job.jira_id }} &mdash;
<span style="color:{% if r.overall_status.value == 'PASS' %}#0a7d24{% elif r.overall_status.value == 'FAIL' %}#c0202a{% else %}#b36b00{% endif %}">
{{ r.overall_status.value }}</span></h2>
<table cellpadding="6" style="border-collapse:collapse" border="1">
<tr><th align="left">Document Scan</th><td>{{ r.doc_status.value }} ({{ r.compliance_score }}%)</td></tr>
<tr><th align="left">Missing documents</th><td>{{ summary.missing }}</td></tr>
<tr><th align="left">Blank documents</th><td>{{ summary.blank }}</td></tr>
<tr><th align="left">Naming issues</th><td>{{ summary.naming }}</td></tr>
<tr><th align="left">Corrupted/protected</th><td>{{ summary.corrupt }}</td></tr>
<tr><th align="left">Code Scan</th><td>{{ r.code_status.value }}</td></tr>
<tr><th align="left">Secrets / passwords / tokens</th><td>{{ summary.secrets }}</td></tr>
<tr><th align="left">Hardcoded IPs</th><td>{{ summary.ips }}</td></tr>
<tr><th align="left">Config credentials</th><td>{{ summary.config_creds }}</td></tr>
</table>
<p>Full details in the attached HTML / CSV / JSON reports and job log.</p>
<p style="color:#888;font-size:12px">Generated by EDCS &mdash; ERIDOC Document &amp; Code Scanner</p>
</body></html>
