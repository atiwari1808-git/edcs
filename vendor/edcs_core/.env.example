# ── ERIDOC ────────────────────────────────────────────────
ERIDOC_REST_URL=https://erid2rest.internal.ericsson.com/d2rest
ERIDOC_REPOSITORY=eridoca
ERIDOC_USERNAME=svc-edcs
ERIDOC_PASSWORD=changeme
ERIDOC_VERIFY_TLS=true
ERIDOC_CA_BUNDLE=
ERIDOC_TIMEOUT_S=30
ERIDOC_MAX_DOC_MB=200
ERIDOC_ROOT_PATH=

# ── Bitbucket ─────────────────────────────────────────────
BITBUCKET_USERNAME=svc-edcs
BITBUCKET_TOKEN=changeme
BITBUCKET_ALLOWED_HOSTS=bitbucket.xxx.com
CLONE_DIR=/var/tmp/edcs/clones
CLONE_DEPTH=1
CLONE_TIMEOUT_S=600
MAX_REPO_MB=2048

# ── Inbound mail ──────────────────────────────────────────
IMAP_HOST=mail.internal.ericsson.com
IMAP_PORT=993
IMAP_USERNAME=edcs-inbox
IMAP_PASSWORD=changeme
IMAP_FOLDER=INBOX
IMAP_ALLOWED_SENDERS=jira@internal.ericsson.com
IMAP_POLL_SECONDS=60

# ── Outbound mail ─────────────────────────────────────────
SMTP_HOST=smtp.internal.ericsson.com
SMTP_PORT=587
SMTP_USERNAME=svc-edcs
SMTP_PASSWORD=changeme
SMTP_STARTTLS=true
MAIL_FROM=edcs-noreply@ericsson.com
MAIL_RECIPIENTS=oss-compliance@ericsson.com
MAIL_CC_REQUESTER=true
MAIL_MAX_ATTACH_MB=15

# ── Scanning policy ───────────────────────────────────────
MANDATORY_DOCS_FILE=config/mandatory_documents.yaml
SECRET_RULES_FILE=config/secret_rules.yaml
ALLOWED_EXTENSIONS=.py,.sh,.bash,.yml,.yaml,.json,.ini,.cfg,.conf,.xml,.properties,.java,.sql,.tf,.tfvars,.env,.txt,.md,.toml,.gradle,.groovy,.js,.ts
EXCLUDED_DIRS=.git,node_modules,venv,.venv,dist,build,target,__pycache__,.idea,.vscode
MAX_FILE_MB=10
SEVERITY_FAIL_THRESHOLD=HIGH
COMPLIANCE_PASS_SCORE=90

# ── Runtime ───────────────────────────────────────────────
TMP_DIR=/var/tmp/edcs
REPORT_DIR=/var/lib/edcs/reports
HISTORY_DB_URL=sqlite:////var/lib/edcs/history.db
WORKERS=4
LOG_LEVEL=INFO
LOG_DIR=/var/log/edcs
