# ── Core ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (leave DB_ENGINE=sqlite for dev; postgres for prod) ──
DB_ENGINE=sqlite
DB_NAME=edcs_gate
DB_USER=edcs
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ── Celery / Redis (EAGER=True runs tasks inline, no Redis needed) ─
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://redis:6379/0
SCANNER_TIMEOUT_SECONDS=600

# ── Scanners ──────────────────────────────────────────────────────
# DEMO_MODE=True returns realistic sample scanner results without
# calling real ERIDOC/Bitbucket. Set False after filling the EDCS
# block below (see INTEGRATION.md for the full walkthrough).
DEMO_MODE=True

# ── EDCS v1.0.1 scanner engine (only needed when DEMO_MODE=False) ──
# These are read directly by the vendored edcs package
# (vendor/edcs_core) — see vendor/edcs_core/.env.example for every
# optional field (mail intake, SMTP, etc. — EDCS-Gate doesn't use those).
ERIDOC_REST_URL=https://erid2rest.internal.ericsson.com/d2rest
ERIDOC_REPOSITORY=eridoca
ERIDOC_USERNAME=svc-edcs
ERIDOC_PASSWORD=
ERIDOC_VERIFY_TLS=true
ERIDOC_ROOT_PATH=
BITBUCKET_USERNAME=svc-edcs
BITBUCKET_TOKEN=
BITBUCKET_ALLOWED_HOSTS=bitbucket.xxx.com
COMPLIANCE_PASS_SCORE=90
SEVERITY_FAIL_THRESHOLD=HIGH

# ── Scheduler mode ────────────────────────────────────────────────
# powerautomate_email (default): booking sends a structured email to
#   PA_TRIGGER_MAILBOX; your Power Automate flow creates the Teams
#   meeting. No Azure AD app registration needed.
# graph: original direct Microsoft Graph integration (needs the Graph
#   block below + tenant consent).
SCHEDULER_MODE=powerautomate_email
# The mailbox your Power Automate flow watches (a shared mailbox is best):
PA_TRIGGER_MAILBOX=edcs-gate-scheduler@ericsson.com
# Subject prefix the flow filters on (keep in sync with the flow):
PA_SUBJECT_PREFIX=[EDCS-GATE-MEETING]
# Subject prefix for the meeting-CANCELLATION trigger flow:
PA_CANCEL_SUBJECT_PREFIX=[EDCS-CANCEL]

# ── Microsoft Graph (leave CLIENT_ID empty → mock mode) ───────────
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_REDIRECT_URI=http://localhost:8000/auth/graph/callback
# Fernet key for encrypting refresh tokens at rest (generate with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# ── Email (internal SMTP relay; console backend if HOST empty) ────
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=edcs-gate-noreply@ericsson.com

# ── App ───────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
